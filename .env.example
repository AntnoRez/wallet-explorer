# =============================================================================
# Wallet Explorer — пример конфигурации
#
# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env
#
# .env в git НЕ попадает (см. .gitignore). Этот файл — попадает,
# он показывает какие переменные нужны, но не их значения.
# =============================================================================

# --- База данных -------------------------------------------------------------
# Используются и docker-compose.yml (поднимает контейнер),
# и сервером (подключается к нему). Файл один на весь проект — в корне.

DB_NAME=wallet_explorer
DB_USER=wallet

# ОБЯЗАТЕЛЬНО. Без него docker compose откажется стартовать —
# так сделано намеренно, чтобы в проекте не завёлся дефолтный пароль.
DB_PASSWORD=

# Порт на ХОСТ-машине. Внутри контейнера Postgres всегда на 5432.
# 5433 взят, чтобы не конфликтовать с нативным Postgres, если он появится.
DB_PORT=5433
DB_HOST=localhost

# Печатать каждый SQL-запрос в консоль. Включай точечно при отладке —
# постоянно включённое сильно засоряет вывод.
DB_LOGGING=false

# Веб-морда к базе, http://localhost:8081
# ВНИМАНИЕ: своей авторизации не имеет. На прод не выкладывать.
ADMINER_PORT=8081

# --- Сервер ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- TronGrid ----------------------------------------------------------------
# Ключ НЕ обязателен: API отвечает и без него, но с низким лимитом.
# Получить: https://www.trongrid.io/  (заголовок TRON-PRO-API-KEY)
# Точные лимиты TronGrid официально не публикует — поэтому в коде
# не хардкодим цифры, а делаем retry с backoff на HTTP 429.
TRONGRID_API_KEY=

# --- TronScan ----------------------------------------------------------------
# Нужен ТОЛЬКО для внутренних переводов (TRX, который контракт двигает внутри
# своего исполнения). TronGrid их не отдаёт вовсе — см. ловушку 5 в README.
# Тоже не обязателен: API отвечает и без ключа.
# Ключ получается отдельно: https://tronscan.org/#/myaccount/apiKeys
# Заголовок тот же — TRON-PRO-API-KEY.
TRONSCAN_API_KEY=

# --- Etherscan V2 (все EVM-сети) ---------------------------------------------
# ОБЯЗАТЕЛЕН, в отличие от ключей Tron: V2 без ключа не отвечает вовсе.
# Получить: https://etherscan.io/myapikey (регистрация бесплатна)
#
# Один ключ работает во всех доступных сетях — сеть задаётся параметром
# chainid в запросе, а не отдельным доменом и не отдельным ключом.
#
# ВНИМАНИЕ: бесплатный тариф покрывает НЕ ВСЕ сети. Проверено запросами:
#   открыты : Ethereum(1), Polygon(137), Arbitrum(42161), Linea, Gnosis,
#             Mantle, Blast, opBNB и ещё два десятка мелких
#   ЗАКРЫТЫ : BSC(56), Base(8453), Optimism(10), Avalanche(43114)
#             -> "Free API access is not supported for this chain"
#
# Именно поэтому первой EVM-сетью выбран Polygon, а не BSC.
#
# Бесплатный тариф: 5 запросов в секунду, 100 000 в сутки.
ETHERSCAN_API_KEY=

# Записей внутренних переводов за запрос. TronScan молча режет до 50 —
# просить больше бессмысленно. Потолок пагинации: start + limit <= 10000.
INTERNAL_FETCH_LIMIT=50

# --- Логика приложения -------------------------------------------------------

# Сеть по умолчанию. Ключ из config/networks.js (строка, не chainId —
# у Tron chainId в EVM-смысле не существует).
DEFAULT_NETWORK=tron

# Сколько минут считаем данные адреса достаточно свежими, чтобы не идти
# в TronGrid повторно. Это НЕ про корректность данных (транзакции
# неизменяемы), а про экономию лимита API.
CACHE_TTL_MINUTES=60

# Записей за один запрос к TronGrid. Максимум у API — 200.
# Внимание: 200 записей из /transactions != 200 переводов TRX,
# после фильтра TransferContract останется заметно меньше.
FETCH_LIMIT=200

# Сколько страниц максимум тянем за один заход (защита от адресов бирж
# с миллионом транзакций).
MAX_PAGES_PER_FETCH=1

# Глубина графа по умолчанию, дней. 0 = отдавать всё, что есть в БД.
# Фильтр применяется при ЧТЕНИИ из БД, на сохранение не влияет:
# храним максимум, фильтруем на чтении.
GRAPH_DAYS=30

# Запас на реорганизации цепи задаётся НЕ ЗДЕСЬ, а в config/networks.js
# полем reorgBufferSec — у каждой сети он свой:
#   Tron 60 с (блок необратим после ~19 подтверждений SR),
#   Polygon 300 с, Ethereum 180 с, Arbitrum 60 с.
# Одно глобальное значение для всех сетей смысла не имеет, поэтому
# переменной окружения тут нет.

# Страниц при ПЕРВОМ обращении к адресу. Здесь важна скорость ответа:
# 1 страница ~3 сек, 5 страниц ~26 сек. Остальное подгружается по кнопке
# «загрузить ещё» (lazy loading).
FIRST_FETCH_PAGES=1

# Разрешённые источники для CORS, через запятую.
# Пусто = разрешено всем. На проде обязательно ограничить: открытый API
# означает, что чужой сайт может жечь наш лимит TronGrid.
CORS_ORIGINS=
